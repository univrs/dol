// sex_imports.dol - Test WASM imports from sex fun without body

// Host imports (no body = WASM import from the VUDO VM: module "vudo", `host_*` names)
sex fun host_log(level: i32, ptr: i32, len: i32) -> i32
sex fun host_time_now() -> i64

// Pure function - has body, gets exported
fun add(a: i64, b: i64) -> i64 {
    return a + b
}

// Sex function with body - also exported
sex fun compute(x: i64) -> i64 {
    return x * 2
}
