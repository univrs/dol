// hello-world.dol - Logging through the VUDO host ABI
//
// A Spirit talks to the VUDO VM only through host functions in WASM import
// module `vudo`. A bodiless `sex fun` declares one of them; the name must be
// one of the 15 `host_*` functions the VM provides, or compilation fails.
//
// host_log(level, msg) -> i32
//   level: 0 = TRACE, 1 = DEBUG, 2 = INFO, 3 = WARN, 4 = ERROR
//   msg:   a DOL `string`, lowered to the ABI's (ptr, len) pair
//   returns 0 on success, -1 on error (unknown level, invalid UTF-8,
//   or missing logging capability)
sex fun host_log(level: i32, msg: string) -> i32

// Log a greeting at INFO level. Exported from the module as `hello`.
sex fun hello() -> i32 {
    return host_log(2, "Hello, World!")
}

// Log any message at DEBUG level.
sex fun debug(msg: string) -> i32 {
    return host_log(1, msg)
}

// Entry point: greet, then emit a debug line. Returns the last result code.
sex fun main() -> i32 {
    hello()
    return debug("hello-world example finished")
}

docs {
    The smallest useful Spirit: it declares the VM's host_log function with
    sex fun and calls it with string literals. The compiler places each
    literal in a data segment, passes its (ptr, len) to the host, and
    exports the module's memory so the VM can read it.
}
