// error-handling.dol - Checking host result codes
//
// Every VUDO host function returns a status value. There are no exceptions
// across the WASM boundary: a Spirit checks the number it gets back.
//
//   host_log            -> i32: 0 on success, -1 on error
//   host_storage_write  -> i32: 0 on success, -1 on error
//
// A call can fail because the Spirit lacks the capability, the input is
// rejected (for host_log: an unknown level or invalid UTF-8), or the host
// backend fails. The code does not say which.
//
// Log levels: 0 = TRACE, 1 = DEBUG, 2 = INFO, 3 = WARN, 4 = ERROR

sex fun host_log(level: i32, msg: string) -> i32

// Storage keys and values are DOL strings, lowered to (ptr, len) pairs.
// The VM treats values as opaque bytes.
sex fun host_storage_write(key: string, value: string) -> i32

// Report a failure at ERROR level. Returns -1 so callers can propagate it.
sex fun report(msg: string) -> i32 {
    host_log(4, msg)
    return -1
}

// Write a key and log the outcome.
// Returns 0 on success, -1 on failure.
sex fun save(key: string, value: string) -> i32 {
    let status = host_storage_write(key, value)
    if status != 0 {
        return report("storage write failed")
    }
    host_log(2, "storage write ok")
    return 0
}

// host_log itself can fail: 7 is not a valid level, so the VM returns -1.
sex fun log_invalid_level() -> i32 {
    let status = host_log(7, "this level does not exist")
    if status != 0 {
        return report("host_log rejected level 7")
    }
    return 0
}

// Entry point: returns 0 only if every step succeeded.
sex fun main() -> i32 {
    let saved = save("greeting", "hello")
    let logged = log_invalid_level()
    if saved != 0 {
        return saved
    }
    return logged
}

docs {
    Demonstrates checking the status codes returned by the VUDO host ABI.
    host_log and host_storage_write return 0 on success and -1 on error.
    The Spirit branches on the value, logs failures at ERROR level with
    host_log, and propagates -1 to its caller.
}
