// effects.dol - Side effects through the VUDO host ABI
//
// In DOL, `sex` marks code with side effects. A Spirit's only side effects
// are calls to host functions in WASM import module `vudo`. This example
// records a state change with three of them: it persists the new value,
// tells peers about it, and logs it.
//
// The VM has no effect publish/subscribe system: a Spirit cannot emit a
// named effect or subscribe to other Spirits' effects. Peers only learn of
// a change through host_network_broadcast, and there is no host function
// for receiving broadcasts yet.
//
//   host_storage_write(key, value) -> i32: 0 on success, -1 on error
//   host_network_broadcast(msg)    -> i64: peer count, or -1 on error
//   host_log(level, msg)           -> i32: 0 on success, -1 on error
//
// Log levels: 0 = TRACE, 1 = DEBUG, 2 = INFO, 3 = WARN, 4 = ERROR

sex fun host_storage_write(key: string, value: string) -> i32

sex fun host_network_broadcast(msg: string) -> i64

sex fun host_log(level: i32, msg: string) -> i32

// Persist a new state, then announce it.
// Returns 0 on success, -1 if the write or the broadcast failed.
sex fun set_state(state: string) -> i32 {
    if host_storage_write("state", state) != 0 {
        host_log(4, "could not persist state")
        return -1
    }
    if host_network_broadcast(state) < 0 {
        host_log(3, "state saved but broadcast failed")
        return -1
    }
    host_log(2, "state changed")
    return 0
}

// Entry point: move to the "running" state.
sex fun main() -> i32 {
    return set_state("running")
}

docs {
    Shows a Spirit's side effects as host calls: host_storage_write
    persists a value, host_network_broadcast sends it to peers, and
    host_log records the outcome. The VUDO VM has no effect pub/sub, so
    there is no emit or subscribe here.
}
