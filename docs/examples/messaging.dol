// messaging.dol - Broadcasting to peers through the VUDO host ABI
//
// host_network_broadcast(msg) -> i64
//   msg:   a DOL `string`, lowered to the ABI's (ptr, len) pair; the VM
//          sends the bytes as-is and rejects an empty message
//   returns the number of peers the message was sent to, or -1 on error
//   (missing broadcast capability, empty or oversized message, or a
//   network backend failure)
//
// Receiving is NOT available: the VM has no host function that delivers
// incoming messages to a Spirit, so this example only sends. The VM also
// provides host_network_connect and host_network_listen, but no function to
// send or receive on the connection they return, so they are not used here.
//
// Log levels for host_log: 0 = TRACE, 1 = DEBUG, 2 = INFO, 3 = WARN, 4 = ERROR

sex fun host_network_broadcast(msg: string) -> i64

sex fun host_log(level: i32, msg: string) -> i32

// Broadcast a message and log the outcome.
// Returns the peer count, or -1 on error.
sex fun announce(msg: string) -> i64 {
    let peers = host_network_broadcast(msg)
    if peers < 0 {
        host_log(4, "broadcast failed")
        return -1
    }
    if peers == 0 {
        host_log(3, "broadcast reached no peers")
        return 0
    }
    host_log(2, "broadcast sent")
    return peers
}

// Entry point: announce this Spirit to its peers.
sex fun main() -> i64 {
    return announce("hello from a DOL Spirit")
}

docs {
    Sends a message to all connected peers with host_network_broadcast and
    logs whether it reached anyone. The VUDO VM currently has no host
    function for receiving messages, so a Spirit cannot read replies.
}
